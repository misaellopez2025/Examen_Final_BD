# =====================================================================
#  1) Copia este archivo y renómbralo a:  .env
#  2) Llena tus datos reales (NUNCA subas el .env a GitHub)
# =====================================================================

# --- Opción A (Neon / Supabase / Render): pega la cadena de conexión completa ---
# En Neon: botón "Connect" > copia el texto que empieza con postgresql://
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Opción B: si en el examen te dan host / usuario / contraseña por separado ---
# Borra o comenta (con #) la línea DATABASE_URL de arriba y llena estas:
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# Pon DB_SSL=false solo si la BD del examen NO usa SSL
# DB_SSL=true

# Puerto donde corre el servidor (http://localhost:3000)
PORT=3000
